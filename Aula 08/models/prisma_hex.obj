# Prisma com hexágono nas tampas — triangulação em leque (n > 3)
mtllib objetos.mtl

# raio 1, altura do hexágono em Y
v  1.0  -0.5  0.0
v  0.5  -0.5  0.866
v -0.5  -0.5  0.866
v -1.0  -0.5  0.0
v -0.5  -0.5 -0.866
v  0.5  -0.5 -0.866

v  1.0   0.5  0.0
v  0.5   0.5  0.866
v -0.5   0.5  0.866
v -1.0   0.5  0.0
v -0.5   0.5 -0.866
v  0.5   0.5 -0.866

vn 0 -1 0
vn 0  1 0

usemtl magenta
f 1//1 2//1 3//1 4//1 5//1 6//1

usemtl amarelo
f 7//2 8//2 9//2 10//2 11//2 12//2

# faces laterais
usemtl verde
f 1 2 8 7
usemtl azul
f 2 3 9 8
usemtl vermelho
f 3 4 10 9
usemtl ciano
f 4 5 11 10
usemtl cinza
f 5 6 12 11
usemtl verde
f 6 1 7 12
