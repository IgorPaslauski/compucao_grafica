# Pirâmide de base quadrada — faces mistas (triângulos e quadrilátero)
mtllib objetos.mtl

v  0   1   0
v -1  -1   1
v  1  -1   1
v  1  -1  -1
v -1  -1  -1

vn 0 0.8944 0.4472
vn 0.8944 0.4472 0
vn 0 0.8944 -0.4472
vn -0.8944 0.4472 0
vn 0 -1 0

usemtl amarelo
f 1//1 2//1 3//1

usemtl verde
f 1//2 3//2 4//2

usemtl azul
f 1//3 4//3 5//3

usemtl vermelho
f 1//4 -3//4 -2//4

usemtl cinza
f 5//5 4//5 3//5 2//5
