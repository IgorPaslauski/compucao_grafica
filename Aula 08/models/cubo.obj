# Cubo com normais explícitas e materiais variados
mtllib objetos.mtl

v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1
v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1

vn 0 0 1
vn 0 0 -1
vn 1 0 0
vn -1 0 0
vn 0 1 0
vn 0 -1 0

usemtl amarelo
f 1//1 2//1 3//1 4//1

usemtl ciano
f 5//2 6//2 7//2 8//2

usemtl vermelho
f 1//6 2//6 6//6 5//6

usemtl azul
f 2//3 3//3 7//3 6//3

usemtl verde
f 3//5 4//5 8//5 7//5

usemtl magenta
f 4//4 1//4 5//4 8//4
